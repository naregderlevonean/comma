#!/bin/sh

is_process_running() {
    pgrep -x "$1" > /dev/null 2>&1
}

hide_waybar() {
    running=false
    if is_process_running "waybar"; then
        running=true
        pkill -x "waybar" 2>/dev/null
    fi
}

restore_waybar() {
    if [ "$running" = true ]; then
        if ! is_process_running "waybar"; then
            waybar &
        fi
    fi
}

confirm() {
    if zenity --question --title="" --text="Do you want to $2?"; then
        systemctl "$1"
    else
        restore_waybar
    fi
}

closeall() {
    if zenity --question --title="" --text="Are you want to close all open applications?"; then
        hyprctl eval "hl.dispatch(helpers.purge.init())"
    else
        restore_waybar
    fi
}

lock() {
    hyprlock
    restore_waybar
}

terminate() {
    if zenity --question --title="" --text="Are you want to Exit?"; then
        loginctl terminate-user "$USER"
    else
        restore_waybar
    fi
}

suspend() {
    confirm "suspend" "Suspend"
}

restart() {
    confirm "reboot" "Reboot"
}

poweroff() {
    confirm "poweroff" "Power Off"
}

dialog() {
    pkill -x "zenity" 2>/dev/null
    hide_waybar

    choice=$(zenity --info \
        --title "" \
        --text="Please select an action to perform with your system" \
        --ok-label "" \
        --extra-button "" \
        --extra-button "" \
        --extra-button "" \
        --extra-button "" \
        --extra-button "" \
        --extra-button "" \
        --timeout="16" )

    case "$choice" in
        "")
            closeall
            ;;
        "")  
            lock
            ;;
        "")  
            terminate
            ;;
        "")  
            suspend
            ;;
        "")  
            restart
            ;;
        "")  
            poweroff
            ;;
        *)
            restore_waybar
            exit 1
            ;;
    esac
}

case "$1" in
    "")
        dialog
        ;;
    closeall|lock|terminate|suspend|restart|poweroff)
        hide_waybar
        "$1"
        ;;
    *)
        exit 1
        ;;
esac


