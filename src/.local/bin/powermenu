#!/bin/sh

PROCESS="zenity"

is_process_running() {
    pgrep "$1" > /dev/null 2>&1
    return $?
}

message() {
    zenity --question --title="" --text="Do you want to $2" && sleep 1 && systemctl "$1"
}

closeall() {
    zenity --question --title="" --text="Are your want to close all open applications?" && sleep 1 && hyprctl eval "actions.purge.init()()"
}

lock() {
    hyprlock
}

terminate() {
    zenity --question --title="" --text="Are your want to Exit?" && sleep 1 && loginctl terminate-user $USER
}

suspend() {
    systemctl suspend
}

restart() {
    message "reboot" "Reboot"
}

poweroff() {
    message "poweroff" "Power Off"
}

dialog() {
    is_process_running "$PROCESS" && killall "$PROCESS"

    choice=$(zenity --info \
        --title "" \
        --text="Please select an action to perform with your system" \
        --ok-label "" \
        --extra-button "" \
        --extra-button "" \
        --extra-button "" \
        --extra-button "" \
        --extra-button "" \
        --extra-button "" \
        --timeout="16" )

    case "$choice" in
        "")
            closeall
            ;;
        "")  
            hyprlock
            ;;
        "")  
            loginctl terminate-user $USER
            ;;
        "")  
            systemctl suspend
            ;;
        "")  
            systemctl reboot
            ;;
        "")  
            systemctl poweroff
            ;;
        *) 
            exit 1
            ;;
    esac
}

case "$1" in
    "")
        dialog
        ;;
    closeall|lock|terminate|suspend|restart|poweroff)
        "$1"
        ;;
    *)
        exit 1
        ;;
esac
