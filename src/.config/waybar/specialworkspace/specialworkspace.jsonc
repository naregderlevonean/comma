{
    "custom/specialworkspace-radio": {
        "format": "",
        "interval": "once",
        "on-click": "hyprctl eval 'actions.specialworkspace.toggle(\"radio\", { start = function() components.waybar.hide()() end, stop = function() components.waybar.show()() end })()'",
        "tooltip": false
    },
    "custom/specialworkspace": {
        "format": "",
        "interval": "once",
        "on-click": "hyprctl eval 'actions.specialworkspace.toggle(\"\", { start = function() components.waybar.hide()() end, stop = function() components.waybar.show()() end })()'",
        "tooltip": false
    },
    "custom/specialworkspace-stylus": {
        "format": "",
        "interval": "once",
        "on-click": "hyprctl eval 'actions.specialworkspace.toggle(\"stylus\", { start = function() components.waybar.hide()() end, stop = function() components.waybar.show()() end })()'",
        "tooltip": false
    },
}
