{
    "custom/specialworkspace": {
        "format": "",
        "interval": "once",
        "on-click": "hyprctl eval 'actions.specialworkspace.toggle(\"\")()'",
        "tooltip": false,
    },
    "custom/specialworkspace-radio": {
        "format": "",
        "interval": "once",
        "on-click": "hyprctl eval 'actions.specialworkspace.toggle(\"radio\")()'",
        "tooltip": false,
    },
    "custom/specialworkspace-stylus": {
        "format": "",
        "interval": "once",
        "on-click": "hyprctl eval 'actions.specialworkspace.toggle(\"stylus\")()'",
        "tooltip": false,
    },
    "custom/specialworkspace-vpn": {
        "format": "",
        "interval": "once",
        "on-click": "hyprctl eval 'actions.specialworkspace.toggle(\"vpn\")()'",
        "tooltip": false,
    },
}
