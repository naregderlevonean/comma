{
    "hyprland/language": {
        "format": "{}",
        "format-en": "🇺🇸 US",
        "format-ru": "🇷🇺 RU",
        "interval": "once",
        "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next",
    },
    "hyprland/workspaces": {
        "all-outputs": false,
        "format": "{icon}",
        "format-icons": {
            "active": "⬤",
            "default": "●",
            "empty": "○",
        },
        "interval": "once",
        "persistent-workspaces": {
            "*": 16,
        },
        "smooth-scrolling-threshold": 3,
    },
    "hyprland/workspaces#windows": {
        "active-only": true,
        "format": "{windows}",
        "workspace-taskbar": {
            "enable": true,
            "format": "{icon}",
            "icon-size": 16,
            "ignore-list": [
                "app.drey.Dialect",
                "com.github.finefindus.eyedropper",
                "dialect",
                "org.belmoussaoui.Authernticator",
                "org.gnome.Characters",
                "org.gnome.Calculator",
                "waypaper",
            ],
            "on-click-window": "hyprctl dispatch 'hl.dsp.focus({ window = \"address:{address}\" })'",
            "update-active-window": true,
        },
    },
}
