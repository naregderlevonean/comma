[
    {
        "exclusive": false,
        "height": 64,
        "include": [
            "backlight/backlight.jsonc",
            "clock/clock.jsonc",
            "common/common.jsonc",
            "communication/communication.jsonc",
            "hyprland/hyprland.jsonc",
            "notifications/notifications.jsonc",
            "power/power.jsonc",
            "pulseaudio/pulseaudio.jsonc",
            "shutdown/shutdown.jsonc",
            "tools/tools.jsonc",
            "walker/walker.jsonc",
        ],
        "modules-left": [
            "custom/walker",
            "custom/separator",
            "group/power",
            "custom/separator",
            "hyprland/language",
            "custom/separator",
            "custom/notifications",
        ],
        "modules-center": ["group/clock"],
        "modules-right": [
            "group/pulseaudio",
            "custom/separator",
            "group/backlight",
            "custom/separator",
            "bluetooth",
            "network",
            "custom/separator",
            "group/tools",
            "custom/separator",
            "group/shutdown",
        ],
        "on-sigusr1": "show",
        "on-sigusr2": "hide",
        "output": ["eDP-1"],
        "position": "top",
        "spacing": 0,
    },
    {
        "exclusive": false,
        "height": 64,
        "include": [
            "common/common.jsonc",
            "hyprland/hyprland.jsonc",
            "pinned/pinned.jsonc",
            "specialworkspace/specialworkspace.jsonc",
            "workspace/workspace.jsonc",
        ],
        "modules-left": [
            "custom/specialworkspace",
            "custom/separator",
            "custom/specialworkspace-stylus",
            "custom/specialworkspace-radio",
            "custom/specialworkspace-vpn",
            "custom/separator",
            "group/pinned",
        ],
        "modules-center": ["group/workspace"],
        "modules-right": ["hyprland/workspaces#windows"],
        "on-sigusr1": "show",
        "on-sigusr2": "hide",
        "output": ["eDP-1"],
        "position": "bottom",
        "spacing": 0,
    },
    {
        "exclusive": false,
        "include": ["hyprland/hyprland.jsonc"],
        "modules-center": ["hyprland/workspaces"],
        "name": "dots",
        "on-sigusr1": "show",
        "on-sigusr2": "hide",
        "passthrough": true,
        "position": "right",
        "spacing": 16,
        "width": 96,
    },
]
