[
    {
        "height": 64,
        "include": [ "./modules.jsonc" ],
        "layer": "top",
        "modifier-reset": "release",
        "modules-left": [
            "custom/apps",
            "custom/separator",
            "group/power",
            "custom/separator",
            "hyprland/language",
            "custom/separator",
            "custom/notifications"
        ],
        "modules-center": ["group/clock"],
        "modules-right": [
            "group/volume",
            "custom/separator",
            "group/brightness",
            "custom/separator",
            "bluetooth",
            "network",
            "custom/separator",
            "group/tools",
            "custom/separator",
            "group/shutdown"
        ],
        "on-sigusr1": "show",
        "on-sigusr2": "hide",
        "output": ["eDP-1"],
        "position": "top",
        "spacing": 16,
    },
    {
        "height": 64,
        "include": [ "./modules.jsonc" ],
        "layer": "top",
        "modifier-reset": "release",
        "modules-left": [
            "custom/special",
            "custom/separator",
            "custom/stylus",
            "custom/radio",
            "custom/separator",
            "group/pinned",
        ],
        "modules-right": [
           "hyprland/workspaces#windows"
        ],
        "on-sigusr1": "show",
        "on-sigusr2": "hide",
        "output": ["eDP-1"],
        "position": "bottom",
        "spacing": 16,
    },
    {
        "exclusive": false,
        "include": [ "./modules.jsonc" ],
        "layer": "bottom",
        "modifier-reset": "release",
        "modules-center": ["hyprland/workspaces"],
        "name": "left",
        "on-sigusr1": "show",
        "on-sigusr2": "hide",
        "output": ["eDP-1"],
        "position": "left",
        "spacing": 16,
        "width": 24,
    },
    {
        "exclusive": false,
        "include": [ "./modules.jsonc" ],
        "layer": "bottom",
        "modifier-reset": "release",
        "name": "right",
        "on-sigusr1": "show",
        "on-sigusr2": "hide",
        "output": ["eDP-1"],
        "position": "right",
        "spacing": 16,
        "width": 20,
    }
]
