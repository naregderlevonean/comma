[
    {
        "height": 64,
        "include": [
            "backlight/backlight.jsonc",
            "clock/clock.jsonc",
            "common/common.jsonc",
            "communication/communication.jsonc",
            "hyprland/hyprland.jsonc",
            "power/power.jsonc",
            "pulseaudio/pulseaudio.jsonc",
            "shutdown/shutdown.jsonc",
            "tools/tools.jsonc"
        ],
        "modifier-reset": "release",
        "modules-left": [
            "custom/apps",
            "custom/separator",
            "group/power",
            "custom/separator",
            "hyprland/language",
            "custom/separator",
            "custom/notifications"
        ],
        "modules-center": ["group/clock"],
        "modules-right": [
            "group/pulseaudio",
            "custom/separator",
            "group/backlight",
            "custom/separator",
            "bluetooth",
            "network",
            "custom/separator",
            "group/tools",
            "custom/separator",
            "group/shutdown"
        ],
        "on-sigusr1": "show",
        "on-sigusr2": "hide",
        "output": ["eDP-1"],
        "position": "top",
        "spacing": 16,
    },
    {
        "height": 64,
        "include": [
            "common/common.jsonc",
            "hyprland/hyprland.jsonc",
            "pinned/pinned.jsonc",
            "specialworkspace/specialworkspace.jsonc",
        ],
        "modifier-reset": "release",
        "modules-left": [
            "custom/specialworkspace",
            "custom/separator",
            "custom/specialworkspace-stylus",
            "custom/specialworkspace-radio",
            "custom/separator",
            "group/pinned",
        ],
        "modules-right": [
           "hyprland/workspaces#windows"
        ],
        "on-sigusr1": "show",
        "on-sigusr2": "hide",
        "output": ["eDP-1"],
        "position": "bottom",
        "spacing": 16,
    },
    {
        "exclusive": false,
        "include": [
            "hyprland/hyprland.jsonc",
        ],
        "modifier-reset": "release",
        "modules-center": ["hyprland/workspaces"],
        "name": "left",
        "on-sigusr1": "show",
        "on-sigusr2": "hide",
        "output": ["eDP-1"],
        "position": "left",
        "spacing": 16,
        "width": 24,
    },
    {
        "exclusive": false,
        "modifier-reset": "release",
        "name": "right",
        "on-sigusr1": "show",
        "on-sigusr2": "hide",
        "output": ["eDP-1"],
        "position": "right",
        "spacing": 16,
        "width": 20,
    }
]
