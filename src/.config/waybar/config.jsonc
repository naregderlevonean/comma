[
    {
        "height": 64,
        "include": [ "./modules.jsonc" ],
        "modifier-reset": "release",
        "modules-left": [
            "custom/apps",
            "custom/separator",
            "group/power",
            "custom/separator",
            "hyprland/language",
            "custom/separator",
            "custom/notifications"
        ],
        "modules-center": ["group/clock"],
        "modules-right": [
            "group/volume",
            "custom/separator",
            "group/brightness",
            "custom/separator",
            "bluetooth",
            "network",
            "custom/separator",
            "group/tools",
            "custom/separator",
            "group/shutdown"
        ],
        "output": ["eDP-1"],
        "position": "top",
        "spacing": 16
    },
    {
        "height": 64,
        "include": [ "./modules.jsonc" ],
        "modifier-reset": "release",
        "modules-left": [
            "custom/special",
            "custom/separator",
            "custom/stylus",
            "custom/radio",
            "custom/separator",
            "group/pinned",
        ],
        "modules-center": ["hyprland/workspaces"],
        "modules-right": [
           "hyprland/workspaces#windows"
        ],
        "output": ["eDP-1"],
        "position": "bottom",
        "spacing": 16
    }
]
