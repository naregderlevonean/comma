{
    "group/workspace": {
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": true,
        },
        "modules": ["custom/name", "custom/separator", "custom/layout"],
        "orientation": "inherit",
    },
    "custom/name": {
        "exec": "hyprctl activeworkspace -j | jq -r '.id'",
        "format": "{}",
        "interval": "once",
        "signal": 7,
        "tooltip": false,
    },
    "custom/layout": {
        "exec": "hyprctl activeworkspace -j | jq -r '.tiledLayout' | tr '[:lower:]' '[:upper:]'",
        "format": "{}",
        "interval": "once",
        "on-click": "hyprctl eval 'actions.workspace.layout()'",
        "signal": 7,
        "tooltip": false,
    },
}
