{
    "group/workspace": {
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": true
        },
        "modules": [
            "custom/name",
            "custom/separator",
            "custom/layout",
        ],
        "orientation": "inherit"
    },
    "custom/name": {
        "exec": "hyprctl activeworkspace -j | jq -r '.name'",
        "format": "{}",
        "interval": "once",
        "signal": 7, 
        "tooltip": false
    },
    "custom/layout": {
        "exec": "hyprctl activeworkspace -j | jq -r '.tiledLayout'",
        "format": "{}",
        "interval": "once",
        "signal": 7, 
        "tooltip": false
    }
}

