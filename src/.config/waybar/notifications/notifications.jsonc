{
    "custom/notifications": {
        "exec": "histui status --all",
        "format": "{icon}",
        "format-icons": {
            "dnd": "",
            "error": "",
            "high": "",
            "low": "",
            "normal": "",
        },
        "interval": 600,
        "on-click": "kitty -e histui",
        "return-type": "json",
    },
}
